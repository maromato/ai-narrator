{
  "llm": {
    "model": "claude-sonnet-4-6",
    "max_tokens": 3500,
    "temperature": 1.0
  },
  "image_gen": {
    "provider": "dalle",
    "model": "gpt-image-2",
    "size": "1024x1536",
    "quality": "low"
  },
  "tts": {
    "provider": "openai",
    "model": "tts-1",
    "voice": "nova",
    "speed": 1.0
  },
  "tts_voicevox": {
    "provider": "voicevox",
    "speaker": 1,
    "base_url": "http://localhost:50021"
  },
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "crf": 18,
    "zoom_max": 1.2
  },
  "video_gen": {
    "provider": "kling",
    "model": "kling-v3",
    "mode": "std",
    "aspect_ratio": "9:16"
  },
  "bgm": {
    "provider": "mubert",
    "email": "your@email.com",
    "volume": 0.2
  },
  "pipeline": {
    "max_retries": 3,
    "retry_wait_min": 2,
    "retry_wait_max": 10,
    "output_dir": "output"
  },
  "cloud": {
    "enabled": true,
    "remote": "gdrive:ai_narrator",
    "cleanup_intermediates": true
  }
}
